<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mecha.radar-diario</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/uv</string>
    <string>run</string>
    <string>--project</string>
    <string>__HOME__/mecha/app/radar</string>
    <string>__HOME__/mecha/app/radar/radar.py</string>
    <string>--todos</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/mecha/logs/radar-diario.log</string>
  <key>StandardErrorPath</key><string>__HOME__/mecha/logs/radar-diario.log</string>
</dict>
</plist>
